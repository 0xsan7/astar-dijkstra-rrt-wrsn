*.aux
*.log
*.out
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz

# Existing tracked artifacts remain tracked regardless of these rules.
# Never use a broad PDF/ZIP/results ignore rule: reviewed research outputs matter.
